# No real addresses, credentials or approved calibration are bundled.
EDGE_ID=demo-edge
SITE_ID=demo-site
DEPLOYMENT_REVISION=demo-release-1
CONFIG_REVISION=demo-r1
CAMERA_ID=demo-camera
RUNTIME_DIR=/opt/ajin/runtime
CONFIG_FILE=/opt/ajin/config/edge.json
CONFIG_SHA256=replace_with_sha256_of_exact_config_bytes
LIDAR_A_IP=192.0.2.10
LIDAR_B_IP=192.0.2.11
MEASUREMENT_URL=https://backend.example.invalid/api/edge/measurements
HEARTBEAT_URL=https://backend.example.invalid/api/edge/heartbeat
MEDIA_WSS_URL=wss://media.example.invalid/api/v1/cameras/demo-camera/stream
EDGE_TOKEN_FILE=/opt/ajin/secrets/edge-token
CAMERA_TOKEN_FILE=/opt/ajin/secrets/camera-token
CAMERA_DEVICE=/dev/video0
VIDEO_GID=replace_with_host_video_gid
# Release must replace image tags with registry image@sha256:... digests.
